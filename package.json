{
  "name": "agrogamez",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web && node scripts/post-export.js",
    "serve": "serve dist",
    "export:android": "expo export -p android",
    "export:ios": "expo export -p ios",
    "build:apk": "eas build -p android --profile preview",
    "upload:apk": "node scripts/upload-apk.js",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage",
    "lint": "expo lint",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.8",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4",
    "@expo/metro-runtime": "~58.0.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "^29.7.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@supabase/.*)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^react-native/setup-env$": "<rootDir>/__mocks__/emptyMock.js",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "hooks/**/*.ts",
      "database/**/*.ts",
      "sync/**/*.ts",
      "!**/*.d.ts"
    ]
  },
  "private": true
}
